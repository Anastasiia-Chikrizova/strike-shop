#!/bin/bash
set -euxo pipefail

# --- Docker ----------------------------------------------------------------
dnf install -y docker git
systemctl enable --now docker
usermod -aG docker ec2-user

# Compose is not packaged for AL2023; it goes in as a CLI plugin binary.
mkdir -p /usr/libexec/docker/cli-plugins
curl -fsSL \
  https://github.com/docker/compose/releases/latest/download/docker-compose-linux-aarch64 \
  -o /usr/libexec/docker/cli-plugins/docker-compose
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

# --- Swap ------------------------------------------------------------------
# dd, not fallocate: the root filesystem is XFS, and swapon rejects files with
# unwritten extents ("skipping - it appears to have holes").
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=$((${swap_size_gb} * 1024)) status=none
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# Swap is an emergency buffer here, not a second tier of RAM: use it only when
# actually short. Default is 60, which starts swapping far too eagerly.
echo 'vm.swappiness=10' > /etc/sysctl.d/99-swappiness.conf
sysctl -p /etc/sysctl.d/99-swappiness.conf

# --- Application -----------------------------------------------------------
git clone ${repo_url} /opt/strike-shop
chown -R ec2-user:ec2-user /opt/strike-shop

# --- Data volume -------------------------------------------------------------
# Separate EBS volume for the Postgres data directory. Formatted only if it has
# no filesystem yet, so a replaced instance picks up the existing database
# instead of wiping it.
DEV=/dev/sdf
for _ in $(seq 1 30); do
  [ -b "$DEV" ] && break
  sleep 2
done

# XFS, not ext4: no lost+found, so the mount point stays empty and Postgres
# does not mistake it for an existing data directory.
blkid "$DEV" >/dev/null 2>&1 || mkfs.xfs "$DEV"

mkdir -p /mnt/data
grep -q "^$DEV " /etc/fstab || echo "$DEV /mnt/data xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
mkdir -p /mnt/data/pgdata

# --- Secrets ---------------------------------------------------------------
# Fetched at boot with the instance's own role, never baked into user_data:
# user_data is readable from inside the instance through IMDS, so anything
# written here would be a secret in plain sight.
#
# umask before the redirects, not chmod after: between creating a file and
# chmod-ing it there is a window where it is world-readable.
umask 077
mkdir -p /etc/strike-shop

for name in stack backend storefront; do
  aws ssm get-parameter \
    --region ${region} \
    --name "${ssm_prefix}/$${name}_env" \
    --with-decryption \
    --query Parameter.Value \
    --output text > "/etc/strike-shop/$${name}.env"
done

chown root:root /etc/strike-shop/*.env
chmod 600 /etc/strike-shop/*.env

# --- Stack -------------------------------------------------------------------
# pull -> migrate -> up -> wait for healthy. On a first boot against an empty
# data volume this is also where the migrations and the seed run.
#
# The fallback is not laziness. deploy.sh runs with `set -e`, and Medusa's
# db:migrate intermittently dies on a "connection timed out" that has nothing
# to do with the database. When the volume already
# carries a migrated database — the normal case when an instance is replaced —
# that failure must not leave the box half-started. The error stays in
# /var/log/cloud-init-output.log, and if the schema really is stale the backend
# will fail its healthcheck, which is visible in `compose ps`.
bash /opt/strike-shop/deploy/deploy.sh || {
  echo "deploy.sh failed — starting the stack without it"
  docker compose \
    --env-file /etc/strike-shop/stack.env \
    -f /opt/strike-shop/docker-compose.deploy.yml \
    up -d
}