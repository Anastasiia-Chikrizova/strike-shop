# This file is needed in TWO places, and the contents must match:
#
#   1. GitHub → Settings → Environments → staging → secret STOREFRONT_ENV
#      (the whole file, as text) — NEXT_PUBLIC_* values are baked into the
#      bundle during `next build`, so the build is meaningless without them;
#   2. on the server at /etc/strike-shop/storefront.env, mode 600 — this is
#      what server-side code reads at runtime.
#
# Change it here and you must update both places and rebuild the image.

# Taken from the staging backend admin: Settings → Publishable API key.
# Without it `next build` fails (check-env-variables.js).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Public backend URL — the one the browser talks to.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.strike-shop.win
NEXT_PUBLIC_BASE_URL=https://strike-shop.win

NEXT_PUBLIC_DEFAULT_REGION=ua
NEXT_PUBLIC_MONOPAY_ENABLED=true

# Must be production. With `development` here `next build` dies during
# prerender with "<Html> should not be imported outside of pages/_document",
# a message that has nothing to do with the actual cause. Confirmed.
NODE_ENV=production

# Fill these in only if product images live in R2 (or another S3-compatible
# store) — next/image only serves images from allowed hosts. Hostname without
# a protocol, e.g. pub-xxxx.r2.dev; pathname with a leading "/", e.g. "/**" to
# allow every path.
# MEDUSA_CLOUD_S3_HOSTNAME=
# MEDUSA_CLOUD_S3_PATHNAME=/**
