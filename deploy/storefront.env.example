# Цей файл потрібен у ДВОХ місцях, і зміст має збігатись:
#
#   1. GitHub → Settings → Environments → staging → секрет STOREFRONT_ENV
#      (весь файл цілком, як текст) — NEXT_PUBLIC_* вшиваються у бандл
#      під час `next build`, тому без них збірка не має сенсу;
#   2. на сервері /etc/strike-shop/storefront.env, права 600 — те, що
#      читається в рантаймі server-side кодом.
#
# Змінив тут — онови обидва місця й перезбери образ.

# Береться в адмінці стейдж-бекенда: Settings → Publishable API key.
# Без нього `next build` падає (check-env-variables.js).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Публічний URL бекенда — той, куди ходить браузер.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.staging.example.com
NEXT_PUBLIC_BASE_URL=https://staging.example.com

NEXT_PUBLIC_DEFAULT_REGION=ua
NEXT_PUBLIC_MONOPAY_ENABLED=true

# Саме production. З `development` тут `next build` падає на пререндері
# з повідомленням «<Html> should not be imported outside of pages/_document»,
# яке до справжньої причини не має жодного стосунку. Перевірено.
NODE_ENV=production

# Заповнювати, тільки якщо файли лежать в S3-сумісному сховищі —
# next/image пускає картинки лише з дозволених хостів.
# MEDUSA_CLOUD_S3_HOSTNAME=
# MEDUSA_CLOUD_S3_PATHNAME=
