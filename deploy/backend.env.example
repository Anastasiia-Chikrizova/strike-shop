# Backend env on the server: /etc/strike-shop/backend.env, mode 600.
# DATABASE_URL and REDIS_URL do NOT go here — they come from stack.env via the
# compose `environment` section, which overrides this file.

# CORS. Real staging domains only, no localhost.
STORE_CORS=https://strike-shop.win
ADMIN_CORS=https://api.strike-shop.win
AUTH_CORS=https://api.strike-shop.win,https://strike-shop.win

# 32+ bytes of randomness each: openssl rand -base64 32
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=

# --- Monobank (staging = sandbox) ----------------------------------------
# WARNING: without MONO_KEY the backend does not start at all. The provider
# throws while the Payment module is loading and Medusa dies with it — this is
# not "payments are broken", it is "the shop is down". Confirmed on the
# staging image.
#
# The URL is the same one production uses; the token is what makes it a
# sandbox. Test token: https://api.monobank.ua/
MONO_API_URL=https://api.monobank.ua
MONO_KEY=

# Both must be public https — Monobank calls in from the outside.
MONO_WEBHOOK_URL=https://api.strike-shop.win/webhooks/monobank
MONO_REDIRECT_URL=https://strike-shop.win/ua/monobank/return

# debit — charge immediately; hold — authorize until captured in the admin.
MONO_PAYMENT_TYPE=debit

# MonoPay widget only: base64(PEM) ECDSA P-256.
# Generate with `npx medusa exec ./src/scripts/monopay-keys.ts generate`.
MONOPAY_PRIVATE_KEY=

# MONO_ALLOW_CLIENT_AMOUNT=true — NEVER on a server: it lets the client send
# its own amount, i.e. pay for an order with a single kopiyka.

# --- Cloudflare R2 (file storage) -----------------------------------------
# WARNING: the storage module switches on only if ALL FIVE are filled in —
# the flag is an && over the whole list (apps/backend/medusa-config.ts). Set
# four and nothing complains: no error, no warning, Medusa boots clean and
# quietly keeps the default local-disk provider. Uploads then land in
# static/ inside the container and die with it. This failure looks exactly
# like success until the container is replaced.
#
# R2_PUBLIC_URL is the bucket's custom domain, no trailing slash — the
# provider concatenates it with the file key, and a stray slash puts // in
# every image URL. Do not point it at an r2.dev development URL: those are
# rate limited and bypass the CDN cache.
#
# Do NOT change this URL once products carry images. Medusa stores the image
# link in the database as an absolute URL, so existing rows keep pointing at
# the old host and nothing rewrites them.
#
# R2_BUCKET is the bucket name, not a hostname — the S3 endpoint is derived
# from R2_ACCOUNT_ID.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=