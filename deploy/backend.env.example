# Env бекенда на сервері: /etc/strike-shop/backend.env, права 600.
# DATABASE_URL і REDIS_URL сюди НЕ пишемо — вони приходять зі stack.env
# через секцію environment у compose і перебивають цей файл.

# CORS. Тільки реальні домени стейджа, без localhost.
STORE_CORS=https://staging.example.com
ADMIN_CORS=https://api.staging.example.com
AUTH_CORS=https://api.staging.example.com,https://staging.example.com

# По 32+ байти випадковості на кожен: openssl rand -base64 32
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=

# --- Monobank (стейдж = пісочниця) ---------------------------------------
# УВАГА: без MONO_KEY бекенд не стартує взагалі. Провайдер кидає виняток
# на завантаженні модуля Payment, і Medusa падає — це не «оплата не працює»,
# а «магазин лежить». Перевірено на стейдж-образі.
#
# URL той самий, що й у бою; пісочницю робить саме токен.
# Тестовий токен: https://api.monobank.ua/
MONO_API_URL=https://api.monobank.ua
MONO_KEY=

# Обидва мають бути публічними https — монобанк ходить сюди ззовні.
MONO_WEBHOOK_URL=https://api.staging.example.com/webhooks/monobank
MONO_REDIRECT_URL=https://staging.example.com/ua/monobank/return

# debit — списання одразу, hold — блокування до capture в адмінці.
MONO_PAYMENT_TYPE=debit

# Тільки для MonoPay-віджета: base64(PEM) ECDSA P-256.
# Генерується `npx medusa exec ./src/scripts/monopay-keys.ts generate`.
MONOPAY_PRIVATE_KEY=

# MONO_ALLOW_CLIENT_AMOUNT=true — НІКОЛИ на сервері: дозволяє клієнту
# прислати свою суму, тобто оплатити замовлення за копійку.
