# TLS is terminated at the Cloudflare edge (the tunnel forwards plain HTTP to
# :80 here), so Caddy does not serve HTTPS itself — otherwise it would redirect
# HTTP→HTTPS, Cloudflare would send HTTP again, and the two would loop forever
# (confirmed in practice: ERR_TOO_MANY_REDIRECTS).
# Domains come from env, see deploy/stack.env.example.

# Backend: Store API, admin dashboard at /app, Monobank webhook at
# /webhooks/monobank.
http://{$BACKEND_DOMAIN} {
	encode zstd gzip

	# The webhook body is verified against its raw bytes — rewrite nothing.
	reverse_proxy backend:9000 {
		# {scheme} is always "http" here (the real Caddy↔cloudflared protocol),
		# not the one the client actually used — that is always https, since it
		# terminates at the Cloudflare edge. Hardcoded, because otherwise the
		# backend believes the connection is insecure and drops the Secure /
		# SameSite attributes on session cookies.
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}

	log {
		output stdout
		format console
	}
}

# Storefront.
http://{$STOREFRONT_DOMAIN} {
	encode zstd gzip

	reverse_proxy storefront:8000 {
		# Same reasoning as above: the hardcoded proto keeps cookie security
		# attributes intact behind the double termination.
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}

	log {
		output stdout
		format console
	}
}
