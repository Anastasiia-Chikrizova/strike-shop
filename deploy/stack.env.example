# Змінні для самого compose (не для застосунків).
# На сервері: /etc/strike-shop/stack.env, права 600.
# Читається через `docker compose --env-file`, див. deploy/deploy.sh.

APP_ENV=staging

# Образи з GHCR. Тег `staging` — рухомий, останній зелений білд з гілки dev.
# Для відтворюваного відкоту став конкретний sha: ...:strike-backend:9f2c1ab...
BACKEND_IMAGE=ghcr.io/anastasiia-chikrizova/strike-backend:staging
STOREFRONT_IMAGE=ghcr.io/anastasiia-chikrizova/strike-storefront:staging

# Env-файли застосунків. Лежать поза репозиторієм, під root, права 600.
BACKEND_ENV_FILE=/etc/strike-shop/backend.env
STOREFRONT_ENV_FILE=/etc/strike-shop/storefront.env

# Postgres у compose. Пароль згенерувати: openssl rand -base64 24
POSTGRES_USER=medusa
POSTGRES_PASSWORD=
POSTGRES_DB=medusa

# Той самий пароль, що вище — тримати синхронно.
# Хости `postgres` і `redis` — це імена сервісів у compose-мережі.
DATABASE_URL=postgres://medusa:<POSTGRES_PASSWORD>@postgres:5432/medusa
REDIS_URL=redis://redis:6379

# Домени для Caddy. A-записи мають вести на публічний IP інстансу.
BACKEND_DOMAIN=api.staging.example.com
STOREFRONT_DOMAIN=staging.example.com
ACME_EMAIL=strikeshop.dev@gmail.com

# Порти для дебагу з самої машини (назовні не публікуються).
BACKEND_PORT=9000
STOREFRONT_PORT=8000
