# Variables for compose itself (not for the applications).
# On the server: /etc/strike-shop/stack.env, mode 600.
# Read via `docker compose --env-file`, see deploy/deploy.sh.

APP_ENV=prod

# Images from ECR. The `prod` tag is floating — the latest green build off
# main. For a reproducible rollback pin a specific sha instead:
# ...:backend:9f2c1ab...
BACKEND_IMAGE=814454905474.dkr.ecr.eu-north-1.amazonaws.com/strike-shop/backend:prod
STOREFRONT_IMAGE=814454905474.dkr.ecr.eu-north-1.amazonaws.com/strike-shop/storefront:prod

# Application env files. They live outside the repository, owned by root,
# mode 600.
BACKEND_ENV_FILE=/etc/strike-shop/backend.env
STOREFRONT_ENV_FILE=/etc/strike-shop/storefront.env

# Postgres in compose. Generate the password with: openssl rand -base64 24
POSTGRES_USER=medusa
POSTGRES_PASSWORD=
POSTGRES_DB=medusa

# Must point at the dedicated EBS volume (/mnt/data/pgdata), not the root
# volume — the root volume is delete_on_termination and replacing the
# instance would silently wipe the database.
POSTGRES_DATA=/mnt/data/pgdata

# Same password as above — keep them in sync.
# The `postgres` and `redis` hosts are compose service names on the internal
# network.
DATABASE_URL=postgres://medusa:<POSTGRES_PASSWORD>@postgres:5432/medusa
REDIS_URL=redis://redis:6379

# Domains for nginx (matched by server_name). These are bound to the
# Cloudflare Tunnel rather than to A records pointing at a public IP — see
# deploy/README.md section 1. TLS is terminated at the Cloudflare edge, so
# nginx only serves plain HTTP on :80.
BACKEND_DOMAIN=api.strike-shop.win
STOREFRONT_DOMAIN=strike-shop.win

# Ports for debugging from the box itself (not published externally).
BACKEND_PORT=9000
STOREFRONT_PORT=8000

# Cloudflare Tunnel connector token — required, compose refuses to start
# without it.
TUNNEL_TOKEN=

# --- Resource limits -------------------------------------------------------
# Defaults live in docker-compose.staging.yml; these override them per
# environment. The sum is what decides the instance size, so measure real
# usage with `docker stats` under load before shrinking anything.
#
# Defaults total roughly 3.4 GB / 4.5 vCPU, which fits a 4 GB instance:
#   postgres 768m, redis 256m, backend 1536m, storefront 768m, nginx 128m
#
# POSTGRES_CPUS=1.0
# POSTGRES_MEMORY=768m
# POSTGRES_MEMORY_MIN=256m
# REDIS_CPUS=0.5
# REDIS_MEMORY=256m
# BACKEND_CPUS=1.5
# BACKEND_MEMORY=1536m
# BACKEND_MEMORY_MIN=512m
# STOREFRONT_CPUS=1.0
# STOREFRONT_MEMORY=768m
# STOREFRONT_MEMORY_MIN=256m
# NGINX_CPUS=0.5
# NGINX_MEMORY=128m
# MIGRATE_CPUS=1.5
# MIGRATE_MEMORY=1g

# --- Logging ---------------------------------------------------------------
# 50m x 3 per service caps json-file logs at ~750 MB across the stack.
# LOG_DRIVER=json-file
# LOG_MAX_SIZE=50m
# LOG_MAX_FILE=3
